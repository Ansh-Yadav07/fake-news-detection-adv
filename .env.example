# Copy to .env and fill in real values. Never commit .env.
# Lines commented out with "#" use the default shown; uncomment only to override.

# Hugging Face access token (used to download/load models).
HF_TOKEN=

# News / search API keys used by the online verification step.
GNEWS_API_KEY=
NEWSDATA_API_KEY=
NEWSAPI_KEY=
SERPAPI_KEY=

# Comma-separated frontend origins allowed by CORS, e.g. http://localhost:5173,https://example.com
ALLOWED_ORIGINS=

# Port the Flask server (app.py) and gunicorn bind to. Default: 5001
# PORT=5001

# Gunicorn worker process count. Default: 1 (models are memory heavy)
# WEB_CONCURRENCY=1

# Rate limit for the analyze endpoint (flask-limiter format). Default: 20 per minute
# RATE_LIMIT=20 per minute

# Time budget in seconds for one analysis request. Default: 8
# ANALYZE_BUDGET_S=8
