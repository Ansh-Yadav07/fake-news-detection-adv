# Copy to .env and fill in real values. Never commit .env.
# Lines commented out with "#" use the default shown; uncomment only to override.

# Hugging Face access token (used to download/load models).
HF_TOKEN=

# If models/transformer has no weights, the transformer (~270 MB) is downloaded from the
# Hugging Face Hub at startup and cached in HF_HOME. On hosts without a persistent disk,
# point HF_HOME at one (or download during the build) so restarts don't re-download.
# Set to 0 to skip loading it (e.g. on very low-memory hosts); verdicts then use the other signals.
# LOAD_TRANSFORMER_FROM_HUB=1
# HF_HOME=/var/data/huggingface

# News / search API keys used by the online verification step.
GNEWS_API_KEY=
NEWSDATA_API_KEY=
NEWSAPI_KEY=
SERPAPI_KEY=

# Comma-separated frontend origins allowed by CORS, e.g. http://localhost:5173,https://example.com
# '*' matches one hostname segment, e.g. https://myapp-*.vercel.app for Vercel preview deployments
ALLOWED_ORIGINS=

# Port the Flask server (app.py) and gunicorn bind to. Default: 5001
# PORT=5001

# Gunicorn worker process count. Default: 1 (models are memory heavy)
# WEB_CONCURRENCY=1

# Rate limit for the analyze endpoint (flask-limiter format). Default: 20 per minute
# RATE_LIMIT=20 per minute

# Time budget in seconds for one analysis request. Default: 8
# ANALYZE_BUDGET_S=8
