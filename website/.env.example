# Copy to .env and adjust. Never commit real secrets.

# Base URL of the Flask backend (no trailing /analyze or /predict).
VITE_API_BASE=http://127.0.0.1:5001

# Optional: how long the browser waits for /analyze before giving up (ms). Default: 90000,
# long enough for a sleeping free-tier backend to wake up.
# VITE_ANALYZE_TIMEOUT_MS=90000

# Legacy (still supported): full predict URL; the /predict suffix is stripped.
# VITE_API_URL=http://127.0.0.1:5001/predict

# Optional: public tunnel hostname (e.g. ngrok) for the dev server.
# When set, Vite allows this host and uses HMR client port 443.
# VITE_ALLOWED_HOST=your-subdomain.ngrok-free.app
